/* ==========================================================================
   Journey Through my Postgraduate Studies — Randiga Harnes
   Design system: stained-slide palette (H&E histology inspired),
   editorial serif display + clean grotesk body, single bold accent.
   ========================================================================== */

:root{
  /* Color */
  --bg:        #150B14;   /* deep aubergine-black, base canvas */
  --bg-panel:  #1F1220;   /* dark plum, panel/card surfaces */
  --bg-panel-2:#29172D;   /* lighter plum, hover/active surfaces */
  --line:      rgba(243,237,231,0.14);
  --line-soft: rgba(243,237,231,0.07);
  --text:      #F3EDE7;   /* warm off-white, slide backlight */
  --text-muted:#BBA7BF;   /* dusty mauve-grey */
  --accent:    #FF3E7A;   /* eosin pink — stain accent */
  --accent-ink:#120810;   /* text-on-accent */
  --accent-2:  #8B7CF0;   /* haematoxylin violet-blue — secondary accent */

  /* Type */
  --font-display: "Fraunces", "Iowan Old Style", "Georgia", serif;
  --font-body: "Inter", -apple-system, "Segoe UI", sans-serif;

  /* Scale */
  --step-0: clamp(1rem, 0.95rem + 0.2vw, 1.05rem);
  --step-1: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
  --step-2: clamp(1.6rem, 1.3rem + 1vw, 2rem);
  --step-3: clamp(2.2rem, 1.6rem + 2vw, 3rem);
  --step-4: clamp(3rem, 2rem + 4vw, 5.5rem);

  --maxw: 1160px;
  --gutter: clamp(1.25rem, 3vw, 3rem);

  color-scheme: dark;
}

*{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior: auto; }
  *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
}

body{
  margin:0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: var(--step-0);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img{ max-width:100%; display:block; }
a{ color: inherit; text-decoration: none; }

h1,h2,h3,h4{
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.08;
  margin: 0 0 0.5em;
  letter-spacing: -0.01em;
}

p{ margin: 0 0 1em; max-width: 38em; }
p.wide{ max-width: none; }

::selection{ background: var(--accent); color: var(--accent-ink); }

:focus-visible{
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 2px;
}

.wrap{
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.section{
  padding: clamp(3.5rem, 8vw, 7rem) 0;
  border-top: 1px solid var(--line-soft);
}

.section-head{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap: 1.5rem;
  margin-bottom: clamp(1.75rem, 4vw, 3rem);
  flex-wrap: wrap;
}

.section-head .num{
  font-family: var(--font-display);
  color: var(--accent);
  font-size: var(--step-1);
  font-variant-numeric: tabular-nums;
}

.section-head h2{ font-size: var(--step-3); margin:0; }

.section-head .desc{
  color: var(--text-muted);
  max-width: 28em;
  margin: 0;
}

/* ---------------- Nav ---------------- */
header.site-nav{
  position: sticky; top:0; z-index: 50;
  background: rgba(21,11,20,0.82);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line-soft);
}
.nav-row{
  display:flex; align-items:center; justify-content:space-between;
  padding: 1rem var(--gutter);
  max-width: var(--maxw); margin: 0 auto;
}
.nav-brand{
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
}
.nav-brand span{ color: var(--accent); }
.nav-links{
  display:flex; gap: clamp(1rem, 2vw, 2rem);
  font-size: 0.95rem;
  list-style:none; margin:0; padding:0;
}
.nav-links a{
  color: var(--text-muted);
  position: relative;
  padding: 0.2rem 0;
}
.nav-links a:hover, .nav-links a.active{ color: var(--text); }
.nav-links a.active::after{
  content:"";
  position:absolute; left:0; right:0; bottom:-6px;
  height:2px; background: var(--accent);
}
.nav-toggle{ display:none; background:none; border:none; color:var(--text); font-size:1.5rem; cursor:pointer; }

@media (max-width: 720px){
  .nav-links{
    position:absolute; top:100%; left:0; right:0;
    background: var(--bg-panel);
    flex-direction:column; padding: 1rem var(--gutter) 1.5rem;
    display:none;
    border-bottom: 1px solid var(--line);
  }
  .nav-links.open{ display:flex; }
  .nav-toggle{ display:block; }
}

/* ---------------- Hero / loader ---------------- */
.hero{
  min-height: 92vh;
  display:flex; flex-direction:column; justify-content:center;
  position: relative;
  overflow:hidden;
}
.hero .wrap{ position:relative; z-index:2; }

.hero-loader{
  position: fixed; inset:0; z-index: 999;
  background: var(--bg);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap: 1.25rem;
  transition: opacity 0.6s ease, visibility 0.6s ease;
}
.hero-loader.done{ opacity:0; visibility:hidden; pointer-events:none; }
.loader-label{
  font-family: var(--font-body);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  color: var(--text-muted);
}
.loader-track{
  width: min(280px, 60vw);
  height: 2px;
  background: var(--line);
  position: relative;
  overflow:hidden;
}
.loader-fill{
  position:absolute; inset:0 100% 0 0;
  background: var(--accent);
  transform-origin: left;
}
.loader-pct{
  font-family: var(--font-display);
  font-size: var(--step-2);
  font-variant-numeric: tabular-nums;
}

.hero-eyebrow{
  color: var(--accent-2);
  font-size: 0.95rem;
  margin-bottom: 1rem;
}
.hero h1{
  font-size: var(--step-4);
  max-width: 15ch;
}
.hero h1 .ac{ color: var(--accent); }
.hero .lede{
  color: var(--text-muted);
  font-size: var(--step-1);
  max-width: 34em;
  margin-top: 1.25rem;
}
.hero-cta{
  display:flex; gap: 1rem; margin-top: 2.25rem; flex-wrap:wrap;
}

.btn{
  display:inline-flex; align-items:center; gap:0.5rem;
  padding: 0.85rem 1.5rem;
  border-radius: 999px;
  font-size: 0.95rem;
  border: 1px solid var(--line);
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}
.btn-solid{ background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight:600; }
.btn-solid:hover{ background: #ff649a; }
.btn-ghost:hover{ border-color: var(--text); }

/* ---------------- About ---------------- */
.about-grid{
  display:grid;
  grid-template-columns: 0.9fr 1.4fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items:start;
}
.about-card{
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 1.75rem;
}
.about-card dl{ margin:0; }
.about-card .row{
  display:flex; justify-content:space-between; gap:1rem;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--line-soft);
  font-size: 0.92rem;
}
.about-card .row:last-child{ border-bottom:none; }
.about-card dt{ color: var(--text-muted); }
.about-card dd{ margin:0; text-align:right; }

.pill-row{ display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:1.25rem; }
.pill{
  border:1px solid var(--line); border-radius:999px;
  padding: 0.3rem 0.85rem; font-size:0.82rem; color: var(--text-muted);
}

@media (max-width: 820px){
  .about-grid{ grid-template-columns: 1fr; }
}

/* ---------------- Research ---------------- */
.research-block{
  background: linear-gradient(155deg, var(--bg-panel) 0%, var(--bg) 100%);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: clamp(1.75rem, 4vw, 3rem);
}
.research-top{
  display:flex; justify-content:space-between; gap:2rem; flex-wrap:wrap;
  margin-bottom: 1.5rem;
}
.research-status{
  font-size: 0.82rem; color: var(--accent-2);
  border: 1px solid rgba(139,124,240,0.4);
  border-radius:999px; padding: 0.3rem 0.85rem;
  align-self:flex-start;
}
.research-facts{
  display:grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
  margin-top: 2rem; padding-top: 1.75rem; border-top:1px solid var(--line-soft);
}
.research-facts .fact-label{ color: var(--text-muted); font-size:0.82rem; margin-bottom:0.35rem; }
.research-facts .fact-val{ font-family: var(--font-display); font-size: var(--step-1); }
@media (max-width:720px){ .research-facts{ grid-template-columns: 1fr 1fr; } }

/* ---------------- Notes timeline ---------------- */
.timeline{ position:relative; }
.timeline-item{
  display:grid; grid-template-columns: 64px 1fr; gap: 1.5rem;
  padding: 1.75rem 0;
  border-bottom: 1px solid var(--line-soft);
}
.timeline-item:first-child{ padding-top:0; }
.timeline-num{
  font-family: var(--font-display); color: var(--accent);
  font-size: var(--step-1); font-variant-numeric: tabular-nums;
}
.timeline-body h3{ font-size: var(--step-1); margin-bottom:0.35rem; }
.timeline-meta{ color: var(--text-muted); font-size:0.85rem; margin-bottom:0.6rem; }
.timeline-body p{ color: var(--text); }
.timeline-link{ color: var(--accent-2); font-size:0.9rem; display:inline-block; margin-top:0.4rem; }
.timeline-link:hover{ text-decoration: underline; }

/* ---------------- Card grid (blog) ---------------- */
.card-grid{
  display:grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
}
@media (max-width: 980px){ .card-grid{ grid-template-columns: repeat(2,1fr); } }
@media (max-width: 640px){ .card-grid{ grid-template-columns: 1fr; } }

.post-card{
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 1.5rem;
  display:flex; flex-direction:column; gap:0.75rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.post-card:hover{ border-color: var(--accent-2); transform: translateY(-3px); }
.post-tag{ color: var(--accent); font-size:0.8rem; }
.post-card h3{ font-size: 1.25rem; margin:0; }
.post-card .post-excerpt{ color: var(--text-muted); font-size:0.92rem; margin:0; }
.post-card .post-meta{ color: var(--text-muted); font-size:0.8rem; margin-top:auto; }

.view-all{ text-align:center; margin-top: 2.5rem; }

/* ---------------- Contact / footer ---------------- */
footer.site-footer{
  border-top: 1px solid var(--line-soft);
  padding: clamp(3rem, 6vw, 5rem) 0 2.5rem;
}
.footer-grid{
  display:flex; justify-content:space-between; gap:2rem; flex-wrap:wrap;
  margin-bottom: 2.5rem;
}
.footer-grid h2{ font-size: var(--step-3); max-width: 12ch; }
.footer-links{ display:flex; flex-direction:column; gap:0.6rem; }
.footer-bottom{
  display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem;
  color: var(--text-muted); font-size:0.85rem;
  border-top: 1px solid var(--line-soft); padding-top:1.5rem;
}

/* ---------------- Simple page header (blog/notes/research pages) ---------------- */
.page-hero{
  padding: clamp(4rem, 8vw, 6rem) 0 2rem;
}
.page-hero .num{ color: var(--accent); font-family: var(--font-display); }
.page-hero h1{ font-size: var(--step-3); margin-top:0.5rem; }
.page-hero p{ color: var(--text-muted); max-width: 40em; }

.back-link{ color: var(--accent-2); font-size:0.9rem; display:inline-block; margin-bottom:1.5rem; }
.back-link:hover{ text-decoration: underline; }

/* ---------------- Post / note article page ---------------- */
article.post-article{ padding-bottom: 4rem; }
article.post-article .post-header{ margin-bottom: 2.5rem; }
article.post-article .post-header .post-tag{ margin-bottom:0.75rem; display:block; }
article.post-article .post-header h1{ font-size: var(--step-3); }
article.post-article .post-header .post-meta{ color: var(--text-muted); margin-top:0.75rem; }
article.post-article .content{ max-width: 42em; }
article.post-article .content h2{ font-size: var(--step-1); margin-top:2rem; }
article.post-article .content p{ color: var(--text); }
article.post-article .content ul, article.post-article .content ol{ color: var(--text); max-width: 38em; padding-left:1.25rem; }
article.post-article .content li{ margin-bottom:0.5rem; }
article.post-article .content blockquote{
  border-left: 3px solid var(--accent);
  margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.25rem;
  color: var(--text-muted); font-style: italic;
}

.empty-state{
  border: 1px dashed var(--line);
  border-radius: 16px;
  padding: 3rem 2rem;
  text-align:center;
  color: var(--text-muted);
}

/* ==========================================================================
   Journey Through my Postgraduate Studies — shared site behaviour
   ========================================================================== */

// ---- Mobile nav toggle -----------------------------------------------
document.addEventListener('DOMContentLoaded', () => {
  const toggle = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', () => links.classList.toggle('open'));
  }

  // Highlight current page in nav
  const here = location.pathname.split('/').pop() || 'index.html';
  document.querySelectorAll('.nav-links a').forEach(a => {
    const target = a.getAttribute('href').split('/').pop();
    if (target === here || (here === '' && target === 'index.html')) {
      a.classList.add('active');
    }
  });
});

// ---- One-time hero loader sequence ------------------------------------
// A single orchestrated "sequencing results" progress moment, echoing a
// lab readout, rather than scattered fade-ins on every section.
function runHeroLoader() {
  const loader = document.querySelector('.hero-loader');
  if (!loader) return;
  const fill = loader.querySelector('.loader-fill');
  const pct = loader.querySelector('.loader-pct');
  let n = 0;
  const words = ['sequencing', 'annotating', 'compiling', 'ready'];
  const label = loader.querySelector('.loader-label');
  const step = () => {
    n += Math.round(4 + Math.random() * 10);
    if (n >= 100) n = 100;
    if (fill) fill.style.clipPath = `inset(0 ${100 - n}% 0 0)`;
    if (pct) pct.textContent = n + '%';
    if (label) label.textContent = words[Math.min(3, Math.floor(n / 26))];
    if (n < 100) {
      requestAnimationFrame(() => setTimeout(step, 60));
    } else {
      setTimeout(() => loader.classList.add('done'), 250);
    }
  };
  step();
}
document.addEventListener('DOMContentLoaded', runHeroLoader);

// ---- Helpers for date formatting ---------------------------------------
function formatDate(iso) {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

// ---- Generic JSON list loader -------------------------------------------
// Fetches a JSON index file and hands the array to a render callback.
// Falls back gracefully (with a note) if opened directly from disk,
// since `fetch` on file:// URLs is blocked by browsers.
async function loadIndex(path, onData, onEmpty) {
  try {
    const res = await fetch(path);
    if (!res.ok) throw new Error('bad response');
    const data = await res.json();
    if (!data.length) { onEmpty(); return; }
    onData(data);
  } catch (err) {
    onEmpty(true);
  }
}

// ---- Render: blog cards (used on index.html preview + blog.html) -------
function renderPostCards(container, posts, opts = {}) {
  const limit = opts.limit || posts.length;
  const linkPrefix = opts.linkPrefix || 'blog/';
  container.innerHTML = posts.slice(0, limit).map(p => `
    <a class="post-card" href="${linkPrefix}${p.slug}.html">
      <span class="post-tag">${p.tag}</span>
      <h3>${p.title}</h3>
      <p class="post-excerpt">${p.excerpt}</p>
      <span class="post-meta">${formatDate(p.date)}</span>
    </a>
  `).join('');
}

// ---- Render: notes timeline (used on index.html preview + notes.html) --
function renderNotesTimeline(container, notes, opts = {}) {
  const limit = opts.limit || notes.length;
  const linkPrefix = opts.linkPrefix || 'notes/';
  container.innerHTML = notes.slice(0, limit).map((n, i) => `
    <div class="timeline-item">
      <div class="timeline-num">${String(i + 1).padStart(2, '0')}</div>
      <div class="timeline-body">
        <h3>${n.title}</h3>
        <div class="timeline-meta">${n.module} &middot; ${formatDate(n.date)}</div>
        <p>${n.summary}</p>
        <a class="timeline-link" href="${linkPrefix}${n.slug}.html">Read the full note &rarr;</a>
      </div>
    </div>
  `).join('');
}

function renderEmpty(container, kind) {
  container.innerHTML = `<div class="empty-state">No ${kind} yet — this is where new entries will appear once added.</div>`;
}

