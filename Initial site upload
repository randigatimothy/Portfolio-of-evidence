<body>

<header class="site-nav">
  <div class="nav-row">
    <a class="nav-brand" href="../index.html">Randiga <span>Harnes</span></a>
    <button class="nav-toggle" aria-label="Toggle navigation">&#9776;</button>
    <ul class="nav-links">
